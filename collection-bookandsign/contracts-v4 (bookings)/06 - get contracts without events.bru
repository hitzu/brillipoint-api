meta {
  name: 06 - get contracts without events
  type: http
  seq: 9
}

get {
  url: {{base_url}}/contracts?excludeWithEvents=true
  body: json
  auth: inherit
}

params:query {
  excludeWithEvents: true
}

headers {
  authorization: Bearer {{token}}
}

tests {
  test("returns 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("this contract has no Event entity, so it stays in the list", function () {
    const body = res.getBody();
    const contractId = Number(bru.getVar("v4_contract_id"));
    const entry = body.find(function (c) { return c.id === contractId; });
    expect(entry, "contract is present").to.not.equal(undefined);
    expect(entry.bookings).to.be.an("array").with.lengthOf(1);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
