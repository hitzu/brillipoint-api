meta {
  name: 04 - unlock prep profile question (admin)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/contracts/{{v4_contract_id}}/prep-profile/unlock
  body: json
  auth: inherit
}

headers {
  authorization: Bearer {{token}}
}

body:json {
  {
    "questionId": "wedding_concept_style",
    "reason": "Cliente pidio ajustar estilo"
  }
}

tests {
  test("unlocks the question (idempotent, works even if never locked)", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().locked.wedding_concept_style).to.not.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
