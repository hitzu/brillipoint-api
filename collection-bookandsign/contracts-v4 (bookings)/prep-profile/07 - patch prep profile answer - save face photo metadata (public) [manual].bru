meta {
  name: 07 - patch prep profile answer - save face photo metadata (public) [manual]
  type: http
  seq: 7
}

patch {
  url: {{base_url}}/contracts/public/{{v4_contract_token}}/prep-profile/answer?phone={{v4_client_phone}}
  body: json
  auth: none
}

body:json {
  {
    "questionId": "face_photos",
    "value": [
      {
        "path": "{{prep_asset_path}}",
        "mime": "{{prep_mime}}"
      }
    ]
  }
}

vars:pre-request {
  prep_mime: image/webp
}

docs {
  Manual-only, excluded from run-bruno-e2e.sh: depends on the uploaded asset
  path from requests 05-06.
}

settings {
  encodeUrl: true
  timeout: 0
}
