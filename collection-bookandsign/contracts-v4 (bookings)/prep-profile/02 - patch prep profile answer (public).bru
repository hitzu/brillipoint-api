meta {
  name: 02 - patch prep profile answer (public)
  type: http
  seq: 2
}

patch {
  url: {{base_url}}/contracts/public/{{v4_contract_token}}/prep-profile/answer?phone={{v4_client_phone}}
  body: json
  auth: none
}

params:query {
  phone: {{v4_client_phone}}
}

body:json {
  {
    "questionId": "event_start_time",
    "value": "17:00"
  }
}

tests {
  test("saves the single answer", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().answers.event_start_time).to.equal("17:00");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
