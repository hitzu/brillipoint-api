meta {
  name: 05 - create prep profile upload url (public) [manual]
  type: http
  seq: 5
}

post {
  url: {{base_url}}/contracts/public/{{v4_contract_token}}/prep-profile/upload-url?phone={{v4_client_phone}}
  body: json
  auth: none
}

params:query {
  phone: {{v4_client_phone}}
}

body:json {
  {
    "questionId": "face_photos",
    "fileName": "face1.webp",
    "mime": "image/webp"
  }
}

script:post-response {
  // Saves response values for requests 06-08 in this flow.
  bru.setVar('prep_contract_id', res.body.contractId);
  bru.setVar('prep_bucket', res.body.bucket);
  bru.setVar('prep_asset_path', res.body.path);
  bru.setVar('prep_public_url', res.body.publicUrl);
  bru.setVar('prep_signed_url', res.body.signedUrl);
  bru.setVar('prep_signed_token', res.body.token);
}

docs {
  Manual-only, excluded from run-bruno-e2e.sh: this returns a real Supabase
  signed upload URL. Runnable on its own against a configured Supabase
  bucket, but not safe to run unattended in CI.
}

settings {
  encodeUrl: true
  timeout: 0
}
