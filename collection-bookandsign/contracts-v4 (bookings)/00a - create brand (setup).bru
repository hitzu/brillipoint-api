meta {
  name: 00a - create brand (setup)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/brands
  body: json
  auth: inherit
}

headers {
  authorization: Bearer {{token}}
}

body:json {
  {
    "name": "E2E contracts-v4 brand {{v4_run_id}}",
    "email": "v4-brand-{{v4_run_id}}@example.com",
    "phoneNumber": "5215555550100"
  }
}

vars:post-response {
  v4_brand_id: res.body.id
}

tests {
  test("creates the brand used by this flow", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("number");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
