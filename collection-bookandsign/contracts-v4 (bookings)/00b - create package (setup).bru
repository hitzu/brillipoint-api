meta {
  name: 00b - create package (setup)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/packages
  body: json
  auth: inherit
}

headers {
  authorization: Bearer {{token}}
}

body:json {
  {
    "brandId": {{v4_brand_id}},
    "name": "E2E contracts-v4 package {{v4_run_id}}",
    "basePrice": 4500
  }
}

vars:post-response {
  v4_package_id: res.body.id
}

tests {
  test("creates the package used by this flow", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.be.a("number");
    expect(res.getBody().brandId).to.equal(Number(bru.getVar("v4_brand_id")));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
