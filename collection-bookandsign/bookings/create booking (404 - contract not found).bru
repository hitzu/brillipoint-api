}

body:json {
  {
    "scheduleType": "exact",
    "eventDate": "2026-11-03",
    "serviceStartsAt": "2026-11-03T14:00:00-06:00",
    "serviceEndsAt": "2026-11-03T18:00:00-06:00",
    "purpose": "scouting",
    "contractId": 999999999
  }
}

tests {
  test("returns 404 when the contract does not exist", function () {
    expect(res.getStatus()).to.equal(404);
  });
}

settings {
