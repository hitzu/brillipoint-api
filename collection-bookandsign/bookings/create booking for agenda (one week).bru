meta {
  name: create booking for agenda (one week)
  type: http
  seq: 8
}

post {
  url: {{base_url}}/bookings/internal
  body: json
  auth: inherit
}

headers {
  authorization: Bearer {{token}}
}

body:json {
  {
    "scheduleType": "exact",
    "eventDate": "2026-12-16",
    "serviceStartsAt": "2026-12-16T14:00:00-06:00",
    "serviceEndsAt": "2026-12-16T18:00:00-06:00",
    "title": "Agenda week fixture",
    "purpose": "other",
    "venueName": "Main hall"
  }
}

vars:post-response {
  agenda_week_booking_id: res.body.id
}

tests {
  test("creates the fixture booking", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
