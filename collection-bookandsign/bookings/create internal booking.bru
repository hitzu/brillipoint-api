meta {
  name: create internal booking
  type: http
  seq: 1
}

post {
  url: {{base_url}}/bookings/internal
  body: json
  auth: inherit
}

headers {
  authorization: Bearer {{token}}
}

body:json {
  {
    "scheduleType": "exact",
    "eventDate": "2026-11-01",
    "serviceStartsAt": "2026-11-01T14:00:00-06:00",
    "serviceEndsAt": "2026-11-01T18:00:00-06:00",
    "title": "Internal cleanup",
    "purpose": "other",
    "venueName": "Main hall",
    "mapsUrl": "https://maps.google.com/?q=main-hall"
  }
}

vars:post-response {
  booking_id: res.body.id
}

tests {
  test("creates the internal booking", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("is a confirmed internal booking with no contract", function () {
    const booking = res.getBody();
    expect(booking.status).to.equal("confirmed");
    expect(booking.contract).to.equal(null);
    expect(booking.eventDate).to.equal("2026-11-01");
    expect(booking.serviceStartsAt).to.not.equal(null);
    expect(booking.serviceEndsAt).to.not.equal(null);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
