meta {
  name: create booking (400 - non-integer contractId)
  type: http
  seq: 20
}

post {
  url: {{base_url}}/bookings
  body: json
  auth: inherit
}

headers {
  authorization: Bearer {{token}}
}

body:json {
  {
    "scheduleType": "exact",
    "eventDate": "2026-11-03",
    "serviceStartsAt": "2026-11-03T14:00:00-06:00",
    "serviceEndsAt": "2026-11-03T18:00:00-06:00",
    "purpose": "scouting",
    "contractId": 1.5
  }
}

tests {
  test("rejects a non-integer contractId before it reaches the contract lookup", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
