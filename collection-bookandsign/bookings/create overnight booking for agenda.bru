meta {
  name: create overnight booking for agenda
  type: http
  seq: 11
}

post {
  url: {{base_url}}/bookings
  body: json
  auth: inherit
}

headers {
  authorization: Bearer {{token}}
}

body:json {
  {
    "scheduleType": "exact",
    "eventDate": "{{ov_overnight_start_date}}",
    "serviceStartsAt": "{{ov_overnight_start_date}}T22:00:00-06:00",
    "serviceEndsAt": "{{ov_overnight_end_date}}T02:00:00-06:00",
    "title": "Agenda overnight fixture",
    "purpose": "other",
    "venueName": "Night hall"
  }
}

vars:post-response {
  agenda_overnight_booking_id: res.body.id
}

tests {
  test("creates the overnight fixture booking", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
