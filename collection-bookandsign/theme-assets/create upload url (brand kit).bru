meta {
  name: create upload url (brand kit)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/theme-assets/upload-url
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

vars:pre-request {
  brand_kit_id: 1
}

body:json {
  {
    "ownerType": "brand-kit",
    "ownerId": {{brand_kit_id}},
    "slot": "logo",
    "fileName": "acme-logo.png",
    "mime": "image/png"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Returns `{ bucket, path, signedUrl, token, publicUrl }`. Upload the file
  to `signedUrl`, then `PATCH /brand-kits/{{brand_kit_id}}` with
  `{ "overrides": { "images": { "logo": { "path": "<path>", "url": "<publicUrl>" } } } }`
  (remember `overrides` replaces the stored value entirely).
}
