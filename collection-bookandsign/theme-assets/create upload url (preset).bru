meta {
  name: create upload url (preset)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/theme-assets/upload-url
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

vars:pre-request {
  event_theme_id: 1
}

body:json {
  {
    "ownerType": "preset",
    "ownerId": {{event_theme_id}},
    "slot": "cover",
    "fileName": "cover.webp",
    "mime": "image/webp"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  404 `EVENT_THEME_NOT_FOUND` when the preset does not exist.
}
