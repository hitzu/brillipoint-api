meta {
  name: create brand kit
  type: http
  seq: 1
}

post {
  url: {{base_url}}/brand-kits
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "key": "acme-corp",
    "name": "Acme Corp",
    "overrides": {
      "tokens": {
        "primary": "#111111",
        "onPrimary": "#ffffff"
      },
      "images": {
        "logo": {
          "path": "brand-kits/acme-corp/logo.png",
          "url": "https://example.com/acme-corp/logo.png"
        }
      }
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  `key` must be a lowercase slug (`^[a-z0-9]+(-[a-z0-9]+)*$`) and is
  immutable afterward. A duplicate key — including one used by a
  soft-deleted kit — returns 409.
}
