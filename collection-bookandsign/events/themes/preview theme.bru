meta {
  name: preview theme
  type: http
  seq: 13
}

post {
  url: {{base_url}}/events/themes/preview
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "eventThemeId": 1,
    "themeOverrides": {
      "tokens": {
        "primary": "#2563eb"
      }
    },
    "honoreesName": "Ana y Luis"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Dry-run resolution: SystemDefault -> Brillipoint default -> preset ->
  overrides. Nothing is persisted.

  Response shape: `{ eventTheme, warnings: string[] }`. `warnings` carries
  non-blocking contrast issues found on the RESOLVED tokens (e.g. overrides that
  only set `primary` against an inherited `onPrimary`) — it never blocks the
  preview.
}
