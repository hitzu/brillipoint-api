meta {
  name: update theme
  type: http
  seq: 12
}

patch {
  url: {{base_url}}/events/themes/{{event_theme_id}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Amor Eterno (renamed)",
    "tokens": {
      "primary": "#16a34a",
      "onPrimary": "#ffffff"
    }
  }
}

vars:pre-request {
  event_theme_id: 1
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  `key` is immutable and is silently stripped if sent (global
  `ValidationPipe({ whitelist: true })`).

  `tokens`/`images`, when sent, REPLACE the stored value entirely — they are
  not deep-merged with the existing value. Omit a field to leave it
  untouched.
}
