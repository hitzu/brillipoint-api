meta {
  name: update event
  type: http
  seq: 6
}

patch {
  url: {{base_url}}/events/{{event_id}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "photoCount": 4
  }
}

vars:pre-request {
  event_id: 1
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Deprecated fields removed from this example body:
  venueName, serviceTypeId, serviceStartsAt, serviceEndsAt, printTemplate,
  decorativeIcon, printTemplates (see the `events` folder docs). v1 still
  accepts them — they are just no longer the source of truth for schedule/
  status. To change an event's schedule/venue, update its EVENT booking
  instead (`bookings` collection).
}
