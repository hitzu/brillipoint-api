meta {
  name: get event by id
  type: http
  seq: 3
}

get {
  url: {{base_url}}/v2/events/id/1
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  See the `v2` folder docs: schedule/status come only from the contract's
  EVENT booking, null/"finished" when there is none.
}
