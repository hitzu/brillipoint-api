meta {
  name: list events
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v2/events
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  See the `v2` folder docs: schedule/status come only from each event's
  contract EVENT booking, null/"finished" when there is none.
}
