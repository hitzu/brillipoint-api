meta {
  name: get event by key
  type: http
  seq: 3
}

get {
  url: {{base_url}}/events/by-key/{{event_key}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

vars:pre-request {
  event_key: 015
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  v1: unchanged payload, still includes the deprecated schedule fields
  (see the `events` folder docs). Prefer `v2/get event by key` for a
  response whose schedule/status come only from the contract's EVENT
  booking.
}
