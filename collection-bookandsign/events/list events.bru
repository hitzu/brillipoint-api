meta {
  name: list events
  type: http
  seq: 4
}

get {
  url: {{base_url}}/events
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  v1: unchanged payload, still includes the deprecated schedule fields
  (see the `events` folder docs). Prefer `v2/list events` for responses
  whose schedule/status come only from each contract's EVENT booking.
}
