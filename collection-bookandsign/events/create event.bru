meta {
  name: create event
  type: http
  seq: 1
}

post {
  url: {{base_url}}/events
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "contractId": {{contract_id}},
    "key": "20",
    "eventTypeId": 1,
    "honoreesNames": "Sinai y Eduardo",
    "albumPhrase": "Nuestro para siempre comienza hoy",
    "delegateName": "Contacto principal",
    "photoCount": 3,
    "eventThemeId": 1
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Deprecated fields removed from this example body:
  serviceTypeId, venueName, serviceLocationUrl, serviceStartsAt,
  serviceEndsAt, printTemplates (see the `events` folder docs). v1 still
  accepts them — they are just no longer the source of truth for schedule/
  status. The event's schedule/venue now come from creating a separate
  EVENT booking for the same contract (`bookings` collection); create the
  event first (as above), then the booking.
}
