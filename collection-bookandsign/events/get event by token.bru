meta {
  name: get event by token
  type: http
  seq: 2
}

get {
  url: {{base_url}}/events/{{event_token}}
  body: none
  auth: inherit
}

headers {
  ~Authorization: Bearer {{token}}
}

vars:pre-request {
  event_token: 80ac24ca-22f2-4e0c-9941-3bdc057dbb65
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  v1: unchanged payload, still includes the deprecated schedule fields
  (see the `events` folder docs). Prefer `v2/get event by token` for a
  response whose schedule/status come only from the contract's EVENT
  booking.
}
