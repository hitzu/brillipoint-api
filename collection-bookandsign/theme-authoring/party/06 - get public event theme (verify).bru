meta {
  name: 06 - get public event theme (verify)
  type: http
  seq: 6
}

get {
  url: {{base_url}}/events/{{event_token}}/theme
  body: none
  auth: none
}

tests {
  test("resolves the public theme for this event", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.eventTheme).to.be.an("object");
    expect(body.eventTheme.tokens).to.be.an("object");
    expect(body.eventTheme.tokens.primary).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Purpose: verify what the public (unauthenticated) endpoint now resolves
  for this event, after step 05.

  Inputs: `event_token` (the event's public token, NOT its numeric id —
  see `events/get event by token.bru`).

  Sets: nothing — terminal step of this flow.

  Response fields that matter: `eventTheme.tokens.*`, `eventTheme.images`
  (should include `cover` if steps 03-05 ran), `eventTheme.decorations`
  (should include the confetti override), `eventTheme.socialCta`
  (Brillipoint fallback, no `socialCta` override in this flow).

  Caveat: this endpoint is cached for 5 minutes — a save in step 05 may not
  be reflected here immediately even though it already is in staff reads
  (`preview`, `get event by id`).
}
