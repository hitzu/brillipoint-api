meta {
  name: 06 - preview with brandKitId
  type: http
  seq: 6
}

post {
  url: {{base_url}}/events/themes/preview
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "brandKitId": {{brand_kit_id}},
    "honoreesName": "Ana y Luis"
  }
}

tests {
  test("resolves the saved kit as the kit layer", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.eventTheme.tokens.primary).to.equal("#0f766e");
    expect(body.eventTheme.params.brandName).to.equal("Acme Events");
    expect(body.warnings).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Purpose: dry-run resolve `SystemDefault -> (no preset) -> saved brand kit
  -> (no event overrides)`, confirming the SAVED kit (step 05) resolves the
  same way the inline preview (step 02) did.

  Inputs: `brand_kit_id` (step 01/05).

  Sets: nothing (read-only dry run).

  Response fields that matter: `eventTheme.tokens.primary` (from the saved
  kit's overrides), `eventTheme.images.logo` (the uploaded logo, if steps
  03-05 ran), `eventTheme.params.brandName` (the saved kit's `name`,
  "Acme Events" — for a saved kit this comes from the row itself, unlike
  the inline preview where it comes from `brandKitName`), `warnings`.
}
