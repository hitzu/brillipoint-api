meta {
  name: 05 - patch brand kit overrides
  type: http
  seq: 5
}

patch {
  url: {{base_url}}/brand-kits/{{brand_kit_id}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "overrides": {
      "tokens": {
        "primary": "#0f766e",
        "onPrimary": "#ffffff"
      },
      "images": {
        "logo": {
          "path": "{{logo_path}}",
          "url": "{{logo_public_url}}"
        }
      },
      "socialCta": {
        "headline": {
          "text": { "es": "Síguenos", "en": "Follow us" }
        },
        "primaryAction": {
          "channel": "whatsapp",
          "label": {
            "text": { "es": "Escríbenos", "en": "Message us" }
          },
          "phone": "5212215775211",
          "message": {
            "text": { "es": "Hola, vi el evento de {{honoreesName}}" }
          }
        },
        "socials": {
          "instagram": "https://www.instagram.com/acme-events"
        }
      }
    }
  }
}

tests {
  test("saves the kit's colors, logo and socialCta", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.id).to.equal(Number(bru.getVar('brand_kit_id')));
    expect(body.overrides.tokens.primary).to.equal("#0f766e");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Purpose: persist the saved counterpart of step 02's inline preview —
  tokens, the uploaded logo, and socialCta — on the real kit created in
  step 01.

  Inputs: `brand_kit_id` (step 01), `logo_path` / `logo_public_url` (steps
  03-04 — if you skipped the manual upload steps, drop `images.logo` from
  the body).

  Sets: nothing further — step 06 previews the saved kit; step 07 assigns
  it to an event.

  Response fields that matter: `overrides` now contains exactly this
  body's `overrides` (REPLACED, not merged with the empty overrides from
  step 01 — sending `overrides` always replaces the whole stored value).

  `key` and `name` are unaffected (not sent); `key` would be silently
  stripped if sent (immutable, global `whitelist: true`).
}
