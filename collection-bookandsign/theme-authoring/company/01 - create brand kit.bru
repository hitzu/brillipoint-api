meta {
  name: 01 - create brand kit
  type: http
  seq: 1
}

post {
  url: {{base_url}}/brand-kits
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "key": "{{kit_key}}",
    "name": "Acme Events"
  }
}

script:pre-request {
  // `key` is unique (409 on conflict, including soft-deleted kits), so
  // this flow generates a fresh one on every run instead of hardcoding it.
  bru.setVar('kit_key', 'acme-events-' + Date.now());
}

script:post-response {
  bru.setVar('brand_kit_id', res.body.id);
}

tests {
  test("creates the brand kit", function () {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.id).to.be.a("number");
    expect(body.key).to.equal(bru.getVar('kit_key'));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Purpose: create the company's brand kit shell (name + immutable key)
  BEFORE uploading any image, since the upload endpoint needs an existing
  `ownerId`. `overrides` is intentionally omitted here — colors/logo/
  socialCta are added in step 05, after the logo exists.

  Inputs: none besides staff auth (`kit_key` is generated in
  `script:pre-request`).

  Sets: `brand_kit_id` for every later step in this flow; `kit_key` (the
  generated unique slug).

  Response fields that matter: `id` (== `brand_kit_id`), `key`, `name`,
  `overrides` (empty object at this point).
}
