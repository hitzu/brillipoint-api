meta {
  name: 02 - preview inline kit (colors + socialCta)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/events/themes/preview
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "brandKit": {
      "tokens": {
        "primary": "#0f766e",
        "onPrimary": "#ffffff"
      },
      "socialCta": {
        "headline": {
          "text": { "es": "Síguenos", "en": "Follow us" }
        },
        "primaryAction": {
          "channel": "whatsapp",
          "label": {
            "text": { "es": "Escríbenos", "en": "Message us" }
          },
          "phone": "5212215775211",
          "message": {
            "text": { "es": "Hola, vi el evento de {{honoreesName}}" }
          }
        },
        "socials": {
          "instagram": "https://www.instagram.com/acme-events"
        }
      }
    },
    "brandKitName": "Acme Events",
    "honoreesName": "Ana y Luis"
  }
}

tests {
  test("resolves the inline kit without saving it", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.eventTheme.tokens.primary).to.equal("#0f766e");
    expect(body.eventTheme.socialCta).to.be.an("object");
    expect(body.warnings).to.be.an("array");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Purpose: dry-run preview an UNSAVED kit's colors and socialCta before
  ever creating overrides on the real kit — no `brand_kit_id` involved,
  `brandKit` here is a plain inline `ThemeOverrides` object.

  Inputs: none besides the inline body (`brandKit` / `brandKitId` are
  mutually exclusive — sending both is a 400).

  Sets: nothing (read-only dry run).

  Response fields that matter: `eventTheme.tokens.primary` (echoes the
  inline override), `eventTheme.socialCta` (this inline kit's block, not
  the Brillipoint fallback), `eventTheme.params.brandName` (== the
  `brandKitName` sent above, since this inline kit supplies socialCta),
  `warnings` (contrast issues on the resolved tokens — e.g. if this kit
  only sets `primary`, a warning may appear pairing it with an inherited
  `onPrimary`).

  Note: `{{honoreesName}}` inside `socialCta.primaryAction.message` is a
  template placeholder the BACKEND never interpolates — the frontend fills
  it from `eventTheme.params.honoreesName`. Only `honoreesName`/`brandName`
  placeholders are allowed; any other `{{key}}` is a 400.
}
